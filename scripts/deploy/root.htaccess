# Subdoména míří na kořen aplikace, ne na public/ – všechno posíláme do public/,
# takže .env, vendor/, storage/ a ostatní soubory mimo public/ nejsou z webu dostupné.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Already-rewritten paths are left alone, otherwise Apache loops.
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
